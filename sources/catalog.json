  "note": "(?i)release[-_]?notes?|rel[-_]?notes|relnotes|_rn\\.html|_rn_",
  "exclude": [
    {"pattern": "(?i)localization|_(ja|zh|ko)_|/content/en/", "why": "translations and copies of the English notes"},
    {"pattern": "(?i)epld|hotfix|/asdm/|/fxos/", "why": "firmware, hotfixes and management tools, not the software followed"},
    {"pattern": "(?i)ipfm|ip-fabric-for-media|ip_fabric_for_media|/ovsdb/|/aci/|/apic/|sonic|live-protect", "why": "NX-OS variants and add-ons the site does not follow"},
    {"pattern": "/threat-defense/\\d+/device-manager-release-notes-", "why": "from 10.0, Cisco splits the Threat Defense notes in two, by manager, with the same bugs: the management center ones are read"},
    {"pattern": "/secure-firewall/integrations/", "why": "Secure Firewall integrations, not Threat Defense"},
    {"pattern": "/security/firepower/6[0-3]\\d/", "why": "Firepower before 6.4, below the oldest branch followed"},
    {"pattern": "(?i)/virtual-routers/|cisco-xrd-|cisco-xrv9000-", "why": "XRd and XRv 9000 virtual routers, not followed"},
    {"pattern": "/routers/ncs[56]000/", "why": "NCS 5000 and NCS 6000, not followed"},
    {"pattern": "/asr1000/release/notes/asr1k_rn_rel_notes", "why": "IOS XE 3S, before the oldest branch followed"},
    {"pattern": "/catalyst3850/software/release/(3|16-[1-8]/)", "why": "Catalyst 3850 before IOS XE 16.9, the oldest branch followed"},
    {"pattern": "/nexus3000/sw/release/703|/datacenter/sw/[67]_x/", "why": "NX-OS 6.x and 7.x, before the oldest branch followed"}
  ],
